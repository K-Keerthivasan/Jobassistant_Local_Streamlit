# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# Env / secrets
.env
*.local

# Generated output (resumes, cover letters, emails)
output/*
!output/.gitkeep

# Incoming job descriptions (may contain scraped data)
data/jobs/*
!data/jobs/.gitkeep
!data/jobs/*_sample.json

# Scraper: your real source list + scraped queue/dedup store
data/sources.yaml
data/intake/

# Personal data (single-user-per-install) — your real profile/answers/companies.
# Ship only the *.sample.* templates; each user creates their own real files.
data/profile/master_profile.yaml
data/profile/personas.yaml
data/apply_profile.json
data/repeat_companies.json
data/usage.json
data/companies/*
!data/companies/.gitkeep

# SQLite store (queue, seen, repeatable roles, company memory, output index)
data/resume.db
data/resume.db-wal
data/resume.db-shm

# OS
Thumbs.db
.DS_Store

# IDE
.idea/
.vscode/
