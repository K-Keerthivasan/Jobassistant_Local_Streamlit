{
  "name": "Resume Auto-Apply (email)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "resume-apply",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "1f0a0001-0000-4000-8000-000000000001",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [240, 300],
      "webhookId": "resume-apply"
    },
    {
      "parameters": {
        "jsCode": "// The Resume Studio app POSTs the application package here.\n// Webhook payload lands under `body`. Turn the base64 files into n8n binary\n// attachments and pass the email fields through.\nconst b = items[0].json.body || items[0].json;\nconst out = { json: {\n  contact_email: b.contact_email || '',\n  company: b.company || '',\n  title: b.title || '',\n  subject: (b.email && b.email.subject) || ('Application for ' + (b.title || '')),\n  body: (b.email && b.email.body) || ''\n}, binary: {} };\nconst add = (key, prop) => {\n  const f = b.files && b.files[key];\n  if (f && f.content_base64) {\n    out.binary[prop] = { data: f.content_base64, fileName: f.filename || (prop + '.pdf'), mimeType: 'application/pdf' };\n  }\n};\nadd('resume', 'resume');\nadd('cover_letter', 'cover');\nreturn [out];"
      },
      "id": "1f0a0001-0000-4000-8000-000000000002",
      "name": "Build attachments",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 300]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            { "value1": "={{ $json.contact_email }}", "operation": "isNotEmpty" }
          ]
        }
      },
      "id": "1f0a0001-0000-4000-8000-000000000003",
      "name": "Has email?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [700, 300]
    },
    {
      "parameters": {
        "sendTo": "={{ $json.contact_email }}",
        "subject": "={{ $json.subject }}",
        "emailType": "text",
        "message": "={{ $json.body }}",
        "options": {
          "attachmentsUi": {
            "attachmentsBinary": [
              { "property": "resume" },
              { "property": "cover" }
            ]
          }
        }
      },
      "id": "1f0a0001-0000-4000-8000-000000000004",
      "name": "Send Gmail",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2,
      "position": [940, 220],
      "credentials": {}
    },
    {
      "parameters": {
        "operation": "appendOrUpdate",
        "documentId": "",
        "sheetName": "",
        "columns": {
          "value": {
            "Company": "={{ $json.company }}",
            "Title": "={{ $json.title }}",
            "Email": "={{ $json.contact_email }}",
            "Status": "Emailed",
            "When": "={{ $now }}"
          }
        },
        "options": {}
      },
      "id": "1f0a0001-0000-4000-8000-000000000005",
      "name": "Log to Sheet (optional)",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [1160, 220],
      "credentials": {}
    }
  ],
  "connections": {
    "Webhook": { "main": [[{ "node": "Build attachments", "type": "main", "index": 0 }]] },
    "Build attachments": { "main": [[{ "node": "Has email?", "type": "main", "index": 0 }]] },
    "Has email?": { "main": [[{ "node": "Send Gmail", "type": "main", "index": 0 }], []] },
    "Send Gmail": { "main": [[{ "node": "Log to Sheet (optional)", "type": "main", "index": 0 }]] }
  },
  "settings": {},
  "active": false
}
