{
  "name": "Email-apply sweep (send generated jobs to HR)",
  "nodes": [
    {
      "parameters": {},
      "id": "6a000001-0000-4000-8000-000000000000",
      "name": "Run now",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [200, 200]
    },
    {
      "parameters": {
        "rule": { "interval": [{ "field": "hours", "hoursInterval": 12 }] }
      },
      "id": "6a000001-0000-4000-8000-000000000001",
      "name": "Every 12h",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [200, 380]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://host.docker.internal:8088/jobs?status=generated",
        "options": { "timeout": 60000 }
      },
      "id": "6a000001-0000-4000-8000-000000000002",
      "name": "GET generated jobs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 300]
    },
    {
      "parameters": { "fieldToSplitOut": "jobs", "options": {} },
      "id": "6a000001-0000-4000-8000-000000000003",
      "name": "Split jobs",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [660, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "loose" },
          "conditions": [
            {
              "id": "has-email",
              "leftValue": "={{ $json.contact_email }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "notEmpty", "singleValue": true }
            },
            {
              "id": "not-applied",
              "leftValue": "={{ $json.applied }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "false", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "6a000001-0000-4000-8000-000000000004",
      "name": "Email + not applied",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2,
      "position": [880, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://host.docker.internal:8088/jobs/{{ $json.key_id }}/send-n8n",
        "options": { "timeout": 120000, "batching": { "batch": { "batchSize": 1, "batchInterval": 2000 } } }
      },
      "id": "6a000001-0000-4000-8000-000000000005",
      "name": "Send via send-n8n",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1100, 300]
    },
    {
      "parameters": { "aggregate": "aggregateAllItemData", "options": {} },
      "id": "6a000001-0000-4000-8000-000000000006",
      "name": "Collect results",
      "type": "n8n-nodes-base.aggregate",
      "typeVersion": 1,
      "position": [1320, 300]
    },
    {
      "parameters": {
        "jsCode": "const rows = items.map(i => i.json).filter(Boolean);\nif (!rows.length) return [{ json: { count: 0, summary: 'No generated email-apply jobs were eligible to send.' } }];\nconst lines = rows.map(r => `• ${r.company || ''} — ${r.title || ''} → ${r.contact_email || ''}`).join('\\n');\nreturn [{ json: { count: rows.length, summary: `Emailed ${rows.length} application(s):\\n\\n${lines}` } }];"
      },
      "id": "6a000001-0000-4000-8000-000000000007",
      "name": "Build summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1540, 300]
    },
    {
      "parameters": {
        "sendTo": "kkvasan99@gmail.com",
        "subject": "={{ $json.count }} applications emailed to HR",
        "emailType": "text",
        "message": "={{ $json.summary }}",
        "options": {}
      },
      "id": "6a000001-0000-4000-8000-000000000008",
      "name": "Notify me",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2,
      "position": [1760, 300],
      "credentials": {}
    }
  ],
  "connections": {
    "Run now": { "main": [[{ "node": "GET generated jobs", "type": "main", "index": 0 }]] },
    "Every 12h": { "main": [[{ "node": "GET generated jobs", "type": "main", "index": 0 }]] },
    "GET generated jobs": { "main": [[{ "node": "Split jobs", "type": "main", "index": 0 }]] },
    "Split jobs": { "main": [[{ "node": "Email + not applied", "type": "main", "index": 0 }]] },
    "Email + not applied": { "main": [[{ "node": "Send via send-n8n", "type": "main", "index": 0 }]] },
    "Send via send-n8n": { "main": [[{ "node": "Collect results", "type": "main", "index": 0 }]] },
    "Collect results": { "main": [[{ "node": "Build summary", "type": "main", "index": 0 }]] },
    "Build summary": { "main": [[{ "node": "Notify me", "type": "main", "index": 0 }]] }
  },
  "settings": {},
  "active": false
}
