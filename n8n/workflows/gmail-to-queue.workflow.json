{
  "name": "Gmail job-alert → queue (/jobs/from-email)",
  "nodes": [
    {
      "parameters": {
        "pollTimes": { "item": [{ "mode": "everyMinute" }] },
        "simple": false,
        "filters": {
          "labelIds": [],
          "q": "label:job-alerts is:unread"
        },
        "options": {}
      },
      "id": "2a000001-0000-4000-8000-000000000001",
      "name": "Gmail Trigger",
      "type": "n8n-nodes-base.gmailTrigger",
      "typeVersion": 1,
      "position": [240, 300],
      "credentials": {}
    },
    {
      "parameters": {
        "jsCode": "// Build the plain text we hand to the parser: subject + best-effort body.\n// Gmail Trigger (simple:false) exposes snippet, payload, and sometimes text/html.\nconst j = items[0].json;\nconst subject = j.subject || (j.headers && j.headers.subject) || '';\nlet body = j.text || j.textPlain || j.snippet || '';\nif (!body && j.html) {\n  body = String(j.html).replace(/<[^>]+>/g, ' ').replace(/\\s+/g, ' ').trim();\n}\nconst text = (subject ? subject + '\\n\\n' : '') + body;\nreturn [{ json: { text, messageId: j.id || '', threadId: j.threadId || '' } }];"
      },
      "id": "2a000001-0000-4000-8000-000000000002",
      "name": "Extract email text",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8088/jobs/from-email",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: $json.text, repeatable: false }) }}",
        "options": { "timeout": 120000 }
      },
      "id": "2a000001-0000-4000-8000-000000000003",
      "name": "POST /jobs/from-email",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [720, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "loose" },
          "conditions": [
            {
              "id": "queued-true",
              "leftValue": "={{ $json.queued }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "true", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "2a000001-0000-4000-8000-000000000004",
      "name": "Queued?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [960, 300]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "markAsRead",
        "messageId": "={{ $('Extract email text').item.json.messageId }}"
      },
      "id": "2a000001-0000-4000-8000-000000000005",
      "name": "Mark read",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2,
      "position": [1200, 220],
      "credentials": {}
    }
  ],
  "connections": {
    "Gmail Trigger": { "main": [[{ "node": "Extract email text", "type": "main", "index": 0 }]] },
    "Extract email text": { "main": [[{ "node": "POST /jobs/from-email", "type": "main", "index": 0 }]] },
    "POST /jobs/from-email": { "main": [[{ "node": "Queued?", "type": "main", "index": 0 }]] },
    "Queued?": { "main": [[{ "node": "Mark read", "type": "main", "index": 0 }], []] }
  },
  "settings": {},
  "active": false
}
