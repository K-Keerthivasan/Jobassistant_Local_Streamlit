{
  "name": "Daily repeatable regenerate (tracked roles)",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [{ "field": "days", "triggerAtHour": 7 }] }
      },
      "id": "4a000001-0000-4000-8000-000000000001",
      "name": "Daily 07:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [220, 320]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://host.docker.internal:8088/repeatable",
        "options": { "timeout": 60000 }
      },
      "id": "4a000001-0000-4000-8000-000000000002",
      "name": "GET /repeatable",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 320]
    },
    {
      "parameters": { "fieldToSplitOut": "roles", "options": {} },
      "id": "4a000001-0000-4000-8000-000000000003",
      "name": "Split roles",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [660, 320]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "loose" },
          "conditions": [
            {
              "id": "status-tracked",
              "leftValue": "={{ $json.status }}",
              "rightValue": "tracked",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "4a000001-0000-4000-8000-000000000004",
      "name": "Only tracked",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2,
      "position": [880, 320]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://host.docker.internal:8088/repeatable/{{ $json.key }}/generate",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ persona: \"auto\", strict: true, pdf: true }) }}",
        "options": { "timeout": 300000, "batching": { "batch": { "batchSize": 1, "batchInterval": 1500 } } }
      },
      "id": "4a000001-0000-4000-8000-000000000005",
      "name": "Regenerate role",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1100, 320]
    },
    {
      "parameters": { "aggregate": "aggregateAllItemData", "options": {} },
      "id": "4a000001-0000-4000-8000-000000000006",
      "name": "Collect results",
      "type": "n8n-nodes-base.aggregate",
      "typeVersion": 1,
      "position": [1320, 320]
    },
    {
      "parameters": {
        "jsCode": "const rows = items.map(i => i.json).filter(Boolean);\nif (!rows.length) return [{ json: { count: 0, summary: 'No tracked repeatable roles to refresh today.' } }];\nconst lines = rows.map(r => `• ${r.folder || (r.company + ' — ' + r.title)}`).join('\\n');\nreturn [{ json: { count: rows.length, summary: `Refreshed ${rows.length} repeatable application(s):\\n\\n${lines}\\n\\nDownload & reapply from the Repeatable tab.` } }];"
      },
      "id": "4a000001-0000-4000-8000-000000000007",
      "name": "Build notice",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1540, 320]
    },
    {
      "parameters": {
        "sendTo": "kkvasan99@gmail.com",
        "subject": "={{ $json.count }} repeatable applications refreshed",
        "emailType": "text",
        "message": "={{ $json.summary }}",
        "options": {}
      },
      "id": "4a000001-0000-4000-8000-000000000008",
      "name": "Email notice",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2,
      "position": [1760, 320],
      "credentials": {}
    }
  ],
  "connections": {
    "Daily 07:00": { "main": [[{ "node": "GET /repeatable", "type": "main", "index": 0 }]] },
    "GET /repeatable": { "main": [[{ "node": "Split roles", "type": "main", "index": 0 }]] },
    "Split roles": { "main": [[{ "node": "Only tracked", "type": "main", "index": 0 }]] },
    "Only tracked": { "main": [[{ "node": "Regenerate role", "type": "main", "index": 0 }]] },
    "Regenerate role": { "main": [[{ "node": "Collect results", "type": "main", "index": 0 }]] },
    "Collect results": { "main": [[{ "node": "Build notice", "type": "main", "index": 0 }]] },
    "Build notice": { "main": [[{ "node": "Email notice", "type": "main", "index": 0 }]] }
  },
  "settings": {},
  "active": false
}
