{
  "name": "Scheduled intake → generate → review notice",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [{ "field": "hours", "hoursInterval": 6 }] }
      },
      "id": "3a000001-0000-4000-8000-000000000001",
      "name": "Every 6 hours",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [220, 320]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8088/intake/run?commit=true",
        "options": { "timeout": 300000 }
      },
      "id": "3a000001-0000-4000-8000-000000000002",
      "name": "POST /intake/run",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 320]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://host.docker.internal:8088/jobs?status=new",
        "options": { "timeout": 60000 }
      },
      "id": "3a000001-0000-4000-8000-000000000003",
      "name": "GET /jobs?status=new",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [660, 320]
    },
    {
      "parameters": { "fieldToSplitOut": "jobs", "options": {} },
      "id": "3a000001-0000-4000-8000-000000000004",
      "name": "Split jobs",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [880, 320]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://host.docker.internal:8088/jobs/{{ $json.key_id }}/generate",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ persona: \"auto\", strict: true, pdf: true }) }}",
        "options": { "timeout": 300000, "batching": { "batch": { "batchSize": 1, "batchInterval": 1500 } } }
      },
      "id": "3a000001-0000-4000-8000-000000000005",
      "name": "Generate each job",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1100, 320]
    },
    {
      "parameters": {
        "aggregate": "aggregateAllItemData",
        "options": {}
      },
      "id": "3a000001-0000-4000-8000-000000000006",
      "name": "Collect results",
      "type": "n8n-nodes-base.aggregate",
      "typeVersion": 1,
      "position": [1320, 320]
    },
    {
      "parameters": {
        "jsCode": "// Summarize what was generated into a short review notice.\nconst rows = items.map(i => i.json).filter(Boolean);\nif (!rows.length) return [{ json: { count: 0, summary: 'No new jobs to generate.' } }];\nconst lines = rows.map(r => {\n  const t = r.persona_label ? ` [${r.persona_label}]` : '';\n  const km = (r.keywordsMatched && r.keywordsMatched.length) || 0;\n  const flag = r.qa_has_violations ? ' ⚠️ QA flags' : '';\n  return `• ${r.folder || (r.company + ' — ' + r.title)}${t} — ${km} kw matched${flag}`;\n}).join('\\n');\nreturn [{ json: { count: rows.length, summary: `Generated ${rows.length} application(s) for review:\\n\\n${lines}\\n\\nReview & approve in Resume Studio.` } }];"
      },
      "id": "3a000001-0000-4000-8000-000000000007",
      "name": "Build notice",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1540, 320]
    },
    {
      "parameters": {
        "sendTo": "kkvasan99@gmail.com",
        "subject": "={{ $json.count }} new applications generated — review",
        "emailType": "text",
        "message": "={{ $json.summary }}",
        "options": {}
      },
      "id": "3a000001-0000-4000-8000-000000000008",
      "name": "Email review notice",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2,
      "position": [1760, 320],
      "credentials": {}
    }
  ],
  "connections": {
    "Every 6 hours": { "main": [[{ "node": "POST /intake/run", "type": "main", "index": 0 }]] },
    "POST /intake/run": { "main": [[{ "node": "GET /jobs?status=new", "type": "main", "index": 0 }]] },
    "GET /jobs?status=new": { "main": [[{ "node": "Split jobs", "type": "main", "index": 0 }]] },
    "Split jobs": { "main": [[{ "node": "Generate each job", "type": "main", "index": 0 }]] },
    "Generate each job": { "main": [[{ "node": "Collect results", "type": "main", "index": 0 }]] },
    "Collect results": { "main": [[{ "node": "Build notice", "type": "main", "index": 0 }]] },
    "Build notice": { "main": [[{ "node": "Email review notice", "type": "main", "index": 0 }]] }
  },
  "settings": {},
  "active": false
}
