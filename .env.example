# Copy to .env and adjust. Never commit .env.

# --- Ollama ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
# Lower temperature = more faithful to the profile (truth-only). 0.2-0.4 recommended.
OLLAMA_TEMPERATURE=0.3

# --- Paths ---
PROFILE_PATH=data/profile/master_profile.yaml
OUTPUT_DIR=output

# --- PDF export ---
# auto | docx2pdf (Windows + MS Word) | libreoffice (cross-platform / Docker)
PDF_ENGINE=auto
LIBREOFFICE_BIN=soffice

# --- API (for n8n / remote devices over Tailscale) ---
API_HOST=0.0.0.0
API_PORT=8088

# --- n8n (email-apply path) ---
# Email-apply jobs are POSTed here (resume + cover letter + email) when you click
# "Send to n8n". Create a Webhook node in n8n and paste its production URL. From the
# container, address n8n via the host gateway, e.g.:
#   N8N_WEBHOOK_URL=http://host.docker.internal:5678/webhook/resume-apply
N8N_WEBHOOK_URL=

# --- Job intake (scraper) ---
# Apify API token, for `type: apify` sources in data/sources.yaml.
# Get it from https://console.apify.com/account/integrations
APIFY_TOKEN=

# --- Email sending (later phase) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=kkvasan99@gmail.com

# Hermes (local agent) engine (optional). When HERMES_API_KEY is set, the model
# picker offers Hermes as a generation engine alongside local Ollama. HERMES_API_KEY
# is the Hermes gateway's API_SERVER_KEY (OpenAI-compatible api_server platform).
# In Docker, set HERMES_BASE_URL=http://host.docker.internal:8642/v1.
HERMES_BASE_URL=http://localhost:8642/v1
HERMES_API_KEY=
HERMES_MODEL=hermes-agent
# Recommended for ChatGPT/Codex-backed Hermes: 2 agent calls per application
# instead of 5. The deterministic truth guard and keyword persona matching remain.
HERMES_FAST_MODE=1
# Optional expensive semantic passes (used only when HERMES_FAST_MODE=0).
HERMES_PERSONA=1
HERMES_QA=1
