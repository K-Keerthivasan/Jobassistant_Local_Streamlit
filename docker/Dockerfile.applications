FROM node:22-bookworm-slim AS build
RUN apt-get update && apt-get install -y --no-install-recommends python3 make g++ \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app/application-mcp
COPY application-mcp/package*.json ./
RUN npm ci
COPY application-mcp/tsconfig.json ./
COPY application-mcp/src ./src
RUN npm run build && npm prune --omit=dev

FROM node:22-bookworm-slim
WORKDIR /app
COPY --from=build /app/application-mcp/node_modules ./application-mcp/node_modules
COPY --from=build /app/application-mcp/dist ./application-mcp/dist
COPY application-mcp/package.json ./application-mcp/package.json
COPY application-mcp/public ./application-mcp/public
RUN mkdir -p /app/application-mcp/config /app/data/job-applications/engine
ENV APP_LISTEN_HOST=0.0.0.0
CMD ["node", "application-mcp/dist/index.js"]
